{
  "name": "@piwork/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "pack:mac": "pnpm licenses:collect && pnpm build && electron-builder --mac dir --arm64 --publish never",
    "dist:mac": "pnpm licenses:collect && pnpm build && electron-builder --mac dmg zip --arm64 --publish never",
    "release:mac": "pnpm licenses:collect && pnpm build && electron-builder --mac dmg zip --arm64 --publish always",
    "setup:electron": "install-electron",
    "licenses:collect": "node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.16",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@office-kit/pptx": "0.28.0",
    "@office-kit/pptx-preview": "0.21.0",
    "@office-kit/xlsx": "0.25.0",
    "@radix-ui/react-use-controllable-state": "1.2.3",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.0.3",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "7.0.15",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "2.5.1",
    "clsx": "^2.1.1",
    "cron-parser": "5.10.1",
    "date-fns": "4.4.0",
    "docx": "9.15.2",
    "docx-preview": "0.3.6",
    "dompurify": "^3.4.17",
    "fast-deep-equal": "3.1.3",
    "framer-motion": "12.42.2",
    "katex": "0.16.47",
    "lucide-react": "0.446.0",
    "motion": "12.42.2",
    "next-intl": "4.14.5",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "4.10.38",
    "radix-ui": "^1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0",
    "shiki": "3.21.0",
    "sonner": "2.0.7",
    "streamdown": "2.3.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typebox": "1.3.27",
    "use-intl": "4.14.5",
    "use-stick-to-bottom": "1.1.6",
    "yauzl": "2.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.2.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "net.piwork.desktop",
    "productName": "PiWork",
    "publish": [
      {
        "provider": "github",
        "owner": "robotbird",
        "repo": "piwork-desktop"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 170,
          "y": 170,
          "type": "file"
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "build/third-party",
        "to": "licenses"
      }
    ],
    "protocols": [
      {
        "name": "PiWork desktop sign-in",
        "schemes": [
          "piwork"
        ]
      }
    ]
  }
}
